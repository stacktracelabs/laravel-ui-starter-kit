{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "run-s \"lint:*\"",
        "lint:oxlint": "oxlint . --fix --ignore-pattern 'resources/js/Components/Base/**'",
        "lint:eslint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli resources/js/"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tsconfig/node24": "^24.0.4",
        "@types/lodash": "^4.17.25",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.8.0",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "~1.77.0",
        "eslint-plugin-vue": "~10.10.0",
        "jiti": "^2.7.0",
        "laravel-vite-plugin": "^3.1.3",
        "npm-run-all2": "^9.0.3",
        "oxlint": "~1.77.0",
        "prettier": "3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.2.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.9"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.28.0",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lodash": "^4.18.1",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.41",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.9",
        "ziggy-js": "^2.6.3"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
